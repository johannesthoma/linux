menu "Windows and ReactOS-specific options"

config WINDOWS
	bool "Windows architecture - compile Windows drivers from Linux sources"
	default y
	select GENERIC_ATOMIC64

config HZ
        int "Clock frequency."
        default 1000

# TODO: those should depend on WINDOWS_ARCH
config 64BIT
	bool "64 bit"
	default n

config 32BIT
	bool "32 bit"
	default y

config MMU
	bool "MMU-based Paged Memory Management Support"
	default n
	help
	  Select if you want MMU-based virtualised addressing space
	  support by paged memory management. If unsure, say 'Y'.

config HUGETLB_PAGE
	bool "Huge TLB. Say no"
	default n
	help
	   Say no.

config KALLSYMS
	bool "allsyms. say no"
	default n
	depends on !WINDOWS
	help
	   Say no.

config HAVE_FUNCTION_DESCRIPTORS
	bool "no"
	default n
	help
	   say no

endmenu
