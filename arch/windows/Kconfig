menu "Windows and ReactOS-specific options"

config WINDOWS
	bool
	default y
	select GENERIC_ATOMIC64

config MMU
	bool
	default n

config HZ
        int
        default 1000

# TODO: those should depend on WINDOWS_ARCH
config 64BIT
	bool
	default n

config 32BIT
	bool
	default y

endmenu
